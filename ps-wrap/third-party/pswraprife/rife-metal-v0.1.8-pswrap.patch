+// PS-WRAP-MAC-FG modification (Apache-2.0 §4b): load the metallib from Contents/Resources of the host app (or an explicit
+// path) before falling back to SwiftPM's Bundle.module, whose app-bundle lookup path (the .app root) breaks code signing.
+func rifeLoadLibrary(_ device: MTLDevice) throws -> MTLLibrary {
+    var candidates: [URL] = []
+    if let p = ProcessInfo.processInfo.environment["RIFE_METAL_LIBRARY"] { candidates.append(URL(fileURLWithPath: p)) }
+    if let r = Bundle.main.resourceURL {
+        candidates.append(r.appendingPathComponent("RifeMetal_RifeMetalCore.bundle/Contents/Resources/default.metallib"))
+        candidates.append(r.appendingPathComponent("rife/default.metallib"))
+    }
+    for url in candidates where FileManager.default.fileExists(atPath: url.path) {
+        if let lib = try? device.makeLibrary(URL: url) { return lib }
+    }
+    return try device.makeDefaultLibrary(bundle: Bundle.module)
+}
